{
  "$schema": "ldc/behaviors/v1",
  "id": "graybox-shy",

  "stateWeights": {
    "Idle": 34,
    "Walk": 30,
    "Sit": 22,
    "Sleep": 14
  },

  "personalityBias": {
    "Walk": { "energy": { "sensitivity": 1.0 } },
    "Sit": { "shyness": { "sensitivity": 0.7 } },
    "Sleep": { "energy": { "sensitivity": -1.3 } },
    "Idle": { "shyness": { "sensitivity": 0.4 } }
  },

  "interactionResponse": {},

  "pettingResponse": {
    "weights": {
      "accept": 40,
      "leanIn": 12,
      "lookUp": 26,
      "pullAway": 22
    },
    "cooldownMs": 0
  },

  "annoyanceResponse": {
    "weights": {
      "turnHeadAway": 34,
      "standUp": 26,
      "walkAway": 40
    },
    "cooldownMs": 0
  },

  "annoyanceBias": {
    "gentleness": { "sensitivity": -0.6 },
    "shyness": { "sensitivity": 1.4 },
    "stubbornness": { "sensitivity": 0.5 }
  },

  "microBehaviors": [
    { "id": "earTwitch", "chancePerMin": 3 },
    { "id": "blink", "chancePerMin": 11 },
    { "id": "headShake", "chancePerMin": 0.8 },
    { "id": "yawn", "chancePerMin": 3.5, "when": "mood.arousal < 0.4" },
    { "id": "stretch", "chancePerMin": 1.5, "when": "justWokeUp" },
    { "id": "sigh", "chancePerMin": 3.5 }
  ],

  "extraRandomness": 0.05
}
