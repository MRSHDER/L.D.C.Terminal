{
  "$schema": "ldc/behaviors/v1",
  "id": "graybox-swift",

  "stateWeights": {
    "Idle": 22,
    "Walk": 26,
    "Sit": 30,
    "Sleep": 22
  },

  "personalityBias": {
    "Walk": { "energy": { "sensitivity": 0.9 } },
    "Sit": { "energy": { "sensitivity": -0.3 } },
    "Sleep": { "energy": { "sensitivity": -0.4 } },
    "Idle": { "curiosity": { "sensitivity": 0.3 } }
  },

  "interactionResponse": {},

  "microBehaviors": [
    { "id": "earTwitch", "chancePerMin": 14 },
    { "id": "blink", "chancePerMin": 20 },
    { "id": "headShake", "chancePerMin": 4 },
    { "id": "yawn", "chancePerMin": 1.5, "when": "mood.arousal < 0.3" },
    { "id": "stretch", "chancePerMin": 1, "when": "justWokeUp" },
    { "id": "sigh", "chancePerMin": 0.6 }
  ],

  "extraRandomness": 0.15
}
